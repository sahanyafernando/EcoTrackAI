# Comma-separated Jac root IDs of registered accounts controlled by the operator.
# Empty means no EcoTrack Central Authority. Export before starting jac run.
ECOTRACK_AUTHORITY_ROOT_IDS=

# Deployment: set a strong random secret through your environment/secret manager.
# Omit locally to use Jac's generated project signing secret.
# JAC_SERVE_AUTH_SECRET=

# Incident Intelligence: export on the SERVER, then restart jac run.
# Jac-native byLLM uses LiteLLM provider model identifiers.
BYLLM_DEFAULT_MODEL=gemini/gemini-3.8-flash
GOOGLE_API_KEY=
# Alternatively use gpt-4o-mini with OPENAI_API_KEY, or anthropic/... with ANTHROPIC_API_KEY.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
ECOTRACK_DUPLICATE_RADIUS_METERS=250
ECOTRACK_DUPLICATE_TIME_WINDOW_HOURS=72
ECOTRACK_DUPLICATE_LOCATION_OVERLAP=0.25
ECOTRACK_DUPLICATE_DESCRIPTION_OVERLAP=0.20
ECOTRACK_DUPLICATE_MIN_SCORE=0.50
ECOTRACK_CLUSTER_CONFIDENCE_THRESHOLD=0.70

# Explicit opt-in for authority-only synthetic data controls. Disabled by default.
ECOTRACK_ENABLE_DEMO_SEED=false
