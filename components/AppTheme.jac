"""Shared visual tokens and responsive styles, embedded to match the working Jac scaffold."""
def:pub AppTheme() -> JsxElement {
    <style>{"""
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#203e34;background:#f5f7f4;font-synthesis:none;--accent:#176344;--border:#e1e8df;--muted:#65766d}
*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}button{cursor:pointer;border:1px solid transparent;border-radius:9px;background:var(--accent);color:white;padding:11px 17px;font-size:14px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:9px;transition:background .15s,border-color .15s}button:hover{background:#104e35}button:disabled{opacity:.55;cursor:default}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid #a1bb62;outline-offset:3px}a{color:var(--accent);text-underline-offset:4px}svg{flex-shrink:0}h1,h2,h3,p{margin-top:0}h1{font-size:32px;line-height:1.2;letter-spacing:-1px;margin-bottom:0}h2{font-size:20px;letter-spacing:-.4px;margin-bottom:13px}h3{font-size:16px;margin-bottom:9px}p{font-size:14px;line-height:1.75}small{line-height:1.5}code{font-size:12px;overflow-wrap:anywhere}summary{cursor:pointer;font-size:13px}details p{margin-top:12px}[hidden]{display:none!important}
.app-shell{min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:246px;background:#fff;border-right:1px solid var(--border);padding:31px 19px 18px;display:flex;flex-direction:column;z-index:30;overflow-y:auto}.brand{display:flex;align-items:center;padding:0;background:transparent;color:#173c2a;justify-content:flex-start;font-size:20px;letter-spacing:-.7px;gap:11px}.brand:hover{background:transparent}.brand b{color:#718873;font-weight:500}.brand-mark{display:grid;place-items:center;background:#1a6043;border-radius:12px;width:39px;height:39px;color:#d2edaa}.brand-mark svg{width:25px;height:25px}.workspace-label{margin:35px 12px 21px;display:grid;gap:6px}.workspace-label strong{font-size:12px;font-weight:600;overflow-wrap:anywhere}.eyebrow{text-transform:uppercase;font-size:10px;letter-spacing:1.7px;color:#6c8072;font-weight:700;margin-bottom:10px}.sidebar nav{display:grid;gap:7px}.nav-item{width:100%;justify-content:flex-start;background:transparent;color:#64756b;font-weight:500;padding:12px 14px;font-size:13px;gap:12px}.nav-item:hover{color:#164b32;background:#f3f7f2}.nav-item.active{background:#e9f2e5;color:#20552f;font-weight:700;border:1px solid #dce9d5}.sidebar-bottom{margin-top:auto;padding-top:38px}.sidebar-note{padding:18px 12px;color:#92a088;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--border);margin-bottom:17px}.sidebar-note p{font-size:11px;line-height:1.7;margin:0}.account-control{color:#284434;background:transparent;width:100%;justify-content:flex-start;padding:7px 10px;text-align:left;gap:11px}.account-control:hover,.account-control.active{background:#f0f5ed}.account-control strong{font-size:12px;display:block;max-width:140px;overflow-wrap:anywhere}.account-control small{display:block;font-size:10px;color:var(--muted);font-weight:400;margin-top:3px}.avatar{display:grid;place-items:center;background:#e7efdf;color:#526e3b;border-radius:50%;width:34px;height:34px;flex-shrink:0;font-size:13px;font-weight:600}.logout-control{background:transparent;color:#6e7c72;font-size:12px;margin-top:10px;padding:9px 12px}.logout-control:hover{background:#f4f6f2;color:#244d35}.logout-control svg{width:16px;height:16px}
.workspace-main{margin-left:246px;min-height:100vh;display:flex;flex-direction:column}.topbar{height:76px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 38px;background:#ffffffd9;backdrop-filter:blur(12px);gap:15px}.topbar-context{display:flex;align-items:center;gap:13px;font-size:12px;min-width:0}.topbar-context strong{font-weight:500}.breadcrumb-separator{color:#c1c9be}.quiet{background:white;color:#36583f;border-color:var(--border);font-weight:500}.quiet:hover{background:#edf3e9;border-color:#cbdac5}.refresh-control{font-size:11px;padding:8px 13px;background:transparent}.page-content{width:100%;max-width:1280px;padding:35px 38px 45px;margin:0 auto;flex:1;min-width:0;outline:none}.page-heading{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:28px}.page-heading .eyebrow{font-size:9px;margin-bottom:8px}.workspace-pill{font-size:10px;color:#617c50;border:1px solid #d9e3d1;background:#f0f5e9;padding:7px 12px;border-radius:99px}.workspace-footer{display:flex;justify-content:space-between;padding:20px 38px;border-top:1px solid var(--border);color:#8a978b;font-size:10px;gap:15px}.workspace-footer span{color:#9da79a}
.page-content section{background:white;border:1px solid var(--border);border-radius:14px;padding:25px;margin-bottom:23px;min-width:0}.welcome-card{display:flex;justify-content:space-between;align-items:center;background:linear-gradient(110deg,#ecf2e2,#e7f0e6)!important;min-height:236px;padding:31px!important;overflow:hidden;position:relative}.welcome-card h2{font-size:29px;letter-spacing:-.9px;color:#244c32}.welcome-card p{color:#617854;font-size:13px}.welcome-card button{margin-top:4px}.welcome-card .eyebrow{font-size:9px;color:#6d855b}.hero-leaf{width:140px;height:140px;display:grid;place-items:center;border:1px solid #c9dbc0;border-radius:50%;background:#ffffff30;transform:rotate(-14deg);margin:5px 17px 5px 20px;color:#719665;flex-shrink:0}.hero-leaf svg{width:72px;height:72px;stroke-width:.8}.welcome-card.authority{background:linear-gradient(115deg,#e3eee8,#e3ede0)!important}.welcome-card.compact{min-height:205px}.metric-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-bottom:23px}.metric-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.metric-grid .metric{margin:0;position:relative;padding:23px}.metric p{color:#687a6b;font-size:12px;margin-bottom:12px}.metric strong{font-size:32px;letter-spacing:-.8px;display:block;font-weight:600;overflow-wrap:anywhere}.metric small{color:#899487;display:block;font-size:11px;margin-top:10px}.metric-icon{position:absolute;top:20px;right:21px;color:#92a980}.metric-icon svg{width:20px;height:20px}.actions{display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap}.actions h2,.actions h3{margin-bottom:0}.actions p{margin-top:8px}.actions .quiet{font-size:11px}.panel>.actions{margin-bottom:20px}.empty-state{padding:35px 15px;text-align:center;color:#7b8d7a;background:#f8faf6;border:1px dashed #dfe7d9;border-radius:10px;margin-top:17px}.empty-state svg{width:30px;height:30px;color:#9bac91;margin-bottom:12px}.empty-state h3{color:#546d4e;font-size:14px}.empty-state p{font-size:12px}.muted{color:var(--muted)}.details{white-space:pre-wrap;overflow-wrap:anywhere}.button-row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}.callout{display:flex;align-items:center;justify-content:space-between;gap:20px;background:#eef3e9!important;border-color:#dce5d4!important}.callout h3{font-size:14px}.callout p{font-size:12px;color:#788770;margin-bottom:0}.callout .quiet{white-space:nowrap;font-size:12px}.overview-links{display:grid;grid-template-columns:1fr 1fr;gap:20px}.action-card{background:white;border:1px solid var(--border);border-radius:13px;padding:24px;display:grid;grid-template-columns:1fr auto;text-align:left;color:#31583a;justify-items:start;gap:13px}.action-card:hover{background:#edf3e9}.action-card strong{grid-column:1;font-size:16px}.action-card span{grid-column:1;font-size:12px;font-weight:400;color:#788871;line-height:1.6}.action-card svg:last-child{grid-column:2;grid-row:2}
.page-content article{border:1px solid var(--border);border-radius:11px;padding:21px;margin-top:16px;background:#fff;min-width:0;overflow-wrap:anywhere}.page-content article h3{text-transform:capitalize;color:#2c5336}.page-content article p{font-size:13px}.page-content article a{font-size:12px}.page-content article p:last-child{margin-bottom:0}.review-card .actions{margin-bottom:15px}.badge{display:inline-flex;align-items:center;gap:5px;border-radius:99px;font-size:10px;font-weight:600;padding:5px 10px;background:#edf2e9;color:#637951;text-transform:capitalize;letter-spacing:.2px}.badge.pending{background:#fbf2da;color:#9a7127}.badge.verified{background:#e7f2e6;color:#39703d}.badge.rejected,.badge.suspended{background:#faeae6;color:#a35945}.badge.planned{text-transform:none;background:#eff0ed;color:#7c8774;font-size:9px}.organization-status{border:1px solid #e5dec3;background:#fcf8e9;padding:26px;border-radius:13px;margin-bottom:23px}.organization-status h2{margin-top:15px}.organization-status p{color:#85774f;margin-bottom:0;font-size:13px}.organization-status.verified{background:#eff6ea;border-color:#d9e8ce}.organization-status.verified p{color:#647e51}.organization-status.rejected,.organization-status.suspended{background:#fcf0ed;border-color:#efd7cf}.organization-status.rejected p,.organization-status.suspended p{color:#936452}.detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin:25px 0 0}.detail-grid dt{font-size:11px;color:#7b8b7a;margin-bottom:8px}.detail-grid dd{margin:0;font-size:13px;overflow-wrap:anywhere;text-transform:capitalize}.profile-heading{display:flex;align-items:center;gap:18px}.profile-heading h2{margin-bottom:7px}.avatar.large{width:62px;height:62px;font-size:23px}.account-details{margin-top:30px;border-top:1px solid var(--border);padding-top:18px}.danger-outline{color:#a35b47;background:white;border:1px solid #e8cfc5}.danger-outline:hover{background:#fbeee8}.planned-state{text-align:center;min-height:390px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:50px 25px!important}.planned-icon{display:grid;place-items:center;background:#f0f5e9;border-radius:19px;width:72px;height:72px;color:#92a57a;margin-bottom:24px}.planned-icon svg{width:34px;height:34px;stroke-width:1.2}.planned-state h2{font-size:25px;margin-top:20px}.planned-state p{max-width:470px;color:#7e8d77;font-size:13px;margin:0}
form{display:grid;gap:17px;max-width:640px;margin-top:22px}label{display:grid;gap:8px;font-size:12px;font-weight:600;color:#466149}input,textarea,select{width:100%;min-width:0;border:1px solid #dbe3d7;border-radius:8px;padding:12px 13px;background:#fcfdfb;color:#2e4b34;font-size:14px;line-height:1.45}input:focus,textarea:focus,select:focus{border-color:#7b9f6a}input:disabled,textarea:disabled{background:#eff3eb;color:#84917a}textarea{min-height:125px;resize:vertical}form>button[type=submit]{justify-self:start;padding-left:24px;padding-right:24px;margin-top:3px}form>p{font-size:12px;margin:0}form p[role=status]:empty{display:none}.notice{background:#edf3e6;border:1px solid #d7e4cc;color:#4d6c3f;padding:13px 17px;border-radius:9px;font-size:12px;overflow-wrap:anywhere;margin-bottom:22px}.notice.error{background:#fcf0eb;border-color:#efd9ce;color:#995d44}.form-message{font-size:12px;color:#697b60;margin-top:20px;max-width:640px;overflow-wrap:anywhere}.page-shortcut{margin:0 0 25px}
.auth-page{min-height:100vh;display:grid;grid-template-columns:minmax(0,1fr) minmax(380px,1fr);background:#fbfcf9}.auth-story{background:#1b4935;color:#f3f5e9;padding:50px 10%;display:flex;flex-direction:column;position:relative;overflow:hidden}.auth-story .brand{color:#f6f8ed}.auth-story .brand b{color:#a9c591}.auth-story .brand-mark{background:#356447;color:#d1e4ad}.auth-story-content{margin:auto 0;padding:80px 0;position:relative;z-index:1}.auth-story-content .eyebrow{color:#a6be8e;font-size:10px}.auth-story h1{font-size:clamp(32px,3.6vw,51px);letter-spacing:-1.8px;line-height:1.2;max-width:500px;margin:20px 0 25px}.auth-story-content p{color:#b2c5b1;max-width:365px;font-size:14px}.auth-story-footer{color:#9eb69c;font-size:11px}.auth-leaf{position:absolute;right:-25px;bottom:90px;color:#315e42;transform:rotate(-25deg)}.auth-leaf svg{width:270px;height:270px;stroke-width:.6}.auth-form-wrap{display:flex;align-items:center;justify-content:center;padding:60px 35px}.auth-card{width:100%;max-width:370px}.auth-card h2{font-size:28px;margin-top:14px}.auth-card>p{font-size:13px;color:#7a8c72}.auth-card form{margin-top:30px;gap:20px}.auth-card form>button[type=submit]{width:100%;justify-self:stretch;margin-top:6px}.auth-switch{background:transparent!important;border:none;color:#32613b;padding:10px 0;margin-top:18px;font-size:12px;font-weight:500}.auth-card .notice{margin-top:20px}.auth-mobile-brand{display:none}.auth-form-wrap .eyebrow{color:#7e9769}.recovery-page{min-height:100vh;display:grid;place-items:center;text-align:center}.recovery-page .brand-mark{margin:auto auto 20px}.menu-toggle,.nav-overlay{display:none}.skip-link{position:fixed;top:-60px;left:270px;z-index:60;padding:12px 20px;background:white;border-radius:8px}.skip-link:focus{top:12px}
@media(min-width:1450px){.page-content{padding-top:43px}.welcome-card{min-height:260px}.metric-grid{gap:24px}}
@media(max-width:1050px){.sidebar{width:220px;padding-left:13px;padding-right:13px}.workspace-main{margin-left:220px}.page-content{padding:27px 25px}.topbar{padding:0 25px}.hero-leaf{width:105px;height:105px;margin-right:0}.hero-leaf svg{width:53px;height:53px}.metric-grid.three{gap:12px}.metric-grid .metric{padding:20px 16px}.metric small{font-size:10px}.metric-icon{display:none}.welcome-card h2{font-size:25px}.welcome-card br{display:none}.workspace-pill{display:none}}
@media(max-width:760px){.sidebar{visibility:hidden;transform:translateX(-100%);transition:transform .2s;width:252px;box-shadow:10px 0 35px #183d2612}.sidebar.open{visibility:visible;transform:translateX(0)}.workspace-main{margin-left:0}.nav-overlay{display:block;position:fixed;inset:0;background:#142c1f66;border-radius:0;z-index:25;border:0;width:100%;height:100%}.nav-overlay:hover{background:#142c1f66}.menu-toggle{display:inline-flex;padding:7px;background:transparent;border:0}.topbar{height:65px;padding:0 17px}.topbar-context{font-size:11px;gap:10px}.topbar-context>.muted,.breadcrumb-separator{display:none}.page-content{padding:26px 19px 32px}.page-heading{margin-bottom:22px}h1{font-size:27px}.page-content section{padding:22px;margin-bottom:19px}.welcome-card{padding:25px!important;min-height:220px}.welcome-card h2{font-size:25px}.hero-leaf{display:none}.metric-grid,.metric-grid.three{grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;margin-bottom:19px}.metric-grid.three .metric:last-child{grid-column:1/-1}.metric strong{font-size:29px}.metric small{font-size:10px}.metric p{font-size:11px}.callout{align-items:flex-start;flex-direction:column;gap:16px}.callout .quiet{white-space:normal}.overview-links{grid-template-columns:1fr;gap:14px}.planned-state{min-height:350px}.workspace-footer{padding:19px;flex-wrap:wrap;font-size:9px}.auth-page{grid-template-columns:1fr}.auth-story{display:none}.auth-form-wrap{min-height:100vh;padding:35px 25px}.auth-mobile-brand{display:flex;margin-bottom:45px}.detail-grid{grid-template-columns:1fr;gap:20px}.skip-link{left:15px}.profile-heading{align-items:flex-start}.actions{align-items:flex-start}.actions h2{font-size:18px}.page-content article{padding:18px}.page-content article code{font-size:10px}.button-row button{font-size:12px}.page-heading .eyebrow{font-size:9px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
"""}</style>
}
